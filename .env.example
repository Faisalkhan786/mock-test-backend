# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mocktest
DB_USER=root
DB_PASSWORD=
# Read-replica (Phase 3) — abhi khaali chhod do, primary hi use hoga
DB_READ_HOST=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Local Redis me khaali. Cloud Redis me password daalo.
REDIS_PASSWORD=

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
# Demo OTP mode: true = OTP hamesha 123456 (SMS nahi bhejega), test ke liye
OTP_DEMO_MODE=true

# ---- Payment ----
# demo = free credits, razorpay = real (Phase 3)
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
